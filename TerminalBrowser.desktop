[Desktop Entry]
Version=1.0
Type=Application
Name=Terminal Browser Navigator
Comment=Navigate the web through terminal prompts
Exec=bash -c "cd '%{DIR}' && bash launch.sh"
Icon=utilities-terminal
Terminal=true
Categories=Network;WebBrowser;

# Instructions:
# 1. Edit this file and replace %{DIR} with the full path to this directory
#    Example: Exec=bash -c "cd '/home/username/terminalguiallos' && bash launch.sh"
# 2. Copy this file to ~/.local/share/applications/ or ~/Desktop/
# 3. Make it executable: chmod +x TerminalBrowser.desktop
# 4. Right-click and select "Allow Launching" or "Trust and Launch"
